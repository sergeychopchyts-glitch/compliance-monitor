<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- CA1707: test names use Method_Condition_Result underscores. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/ComplianceMonitor.Api/ComplianceMonitor.Api.csproj" />
    <ProjectReference Include="../../src/ComplianceMonitor.Application/ComplianceMonitor.Application.csproj" />
    <ProjectReference Include="../../src/ComplianceMonitor.Infrastructure/ComplianceMonitor.Infrastructure.csproj" />
    <ProjectReference Include="../../tools/LabelLab/LabelLab.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <!-- The real HF response the parser is coded against. -->
    <None Include="../../docs/hf-sample-response.json" Link="TestData/hf-sample-response.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
