<Project Sdk="Microsoft.NET.Sdk">
  <!-- Implements the Application abstractions: EF Core/SQLite persistence and the Hugging Face model gateway. -->
  <ItemGroup>
    <!-- Options, configuration binding, HttpClientFactory, health checks: no extra NuGet packages. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <!-- Tests exercise implementation types (repository, gateway, cache) that aren't part of the public surface. -->
    <InternalsVisibleTo Include="ComplianceMonitor.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../ComplianceMonitor.Application/ComplianceMonitor.Application.csproj" />
  </ItemGroup>
</Project>
